{
  "name": "CarryGo",
  "main": "expo-router/entry",
  "version": "1.2.2",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verify": "node ./scripts/verify-rls.mjs && node ./scripts/verify-domain-commands.mjs && node ./scripts/verify-phase4-realtime.mjs",
    "test:rls": "node ./scripts/verify-rls.mjs",
    "test:domain": "node ./scripts/verify-domain-commands.mjs",
    "test:phase4": "node ./scripts/verify-phase4-realtime.mjs",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build:web",
    "doctor": "npx expo-doctor",
    "build:web": "expo export --platform web --output-dir dist/web",
    "supabase:types": "supabase gen types typescript --local > types/database.ts"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "unimodules-app-loader"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "dependencies": {
    "@expo/metro-runtime": "5.0.5",
    "@expo/vector-icons": "^14.0.0",
    "@gorhom/bottom-sheet": "4.4.6",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "^8.4.1",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/core": "7.8.5",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@react-navigation/routers": "7.3.5",
    "@shopify/flash-list": "1.7.6",
    "@supabase/supabase-js": "^2.50.0",
    "@tanstack/query-async-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "expo": "~53.0.27",
    "expo-application": "~6.1.4",
    "expo-blur": "~14.1.4",
    "expo-clipboard": "^7.1.5",
    "expo-constants": "~17.1.6",
    "expo-device": "~7.1.4",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.1",
    "expo-image-manipulator": "^13.1.7",
    "expo-image-picker": "^16.1.4",
    "expo-linear-gradient": "~14.1.4",
    "expo-linking": "^7.1.5",
    "expo-location": "~18.1.6",
    "expo-notifications": "~0.31.2",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-edge-to-edge": "1.6.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-maps": "1.20.1",
    "react-native-razorpay": "^2.3.0",
    "react-native-reanimated": "3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.14",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18",
      "on-headers": "1.1.0",
      "postcss": "8.5.23",
      "undici": "7.29.0",
      "uuid": "11.1.1",
      "ws": "8.21.0"
    }
  }
}
