# Public client configuration. Never place service-role or private secrets here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# AWS S3 + CloudFront (public config only)
# NOTE: AWS credentials (ACCESS_KEY_ID, SECRET_ACCESS_KEY) are configured as
# Supabase Edge Function secrets, NOT in client env vars. See:
# supabase secrets set AWS_ACCESS_KEY_ID=xxx AWS_SECRET_ACCESS_KEY=xxx AWS_REGION=ap-south-1
EXPO_PUBLIC_AWS_REGION=ap-south-1
EXPO_PUBLIC_AWS_BUCKET_PARCEL_PROOFS=carrygo-parcel-proofs
EXPO_PUBLIC_AWS_BUCKET_USER_DOCS=carrygo-user-documents
EXPO_PUBLIC_CF_PARCEL_PROOFS=your-cloudfront-domain.cloudfront.net
EXPO_PUBLIC_CF_USER_DOCS=your-second-cloudfront-domain.cloudfront.net

# Razorpay (public key only - secret stays in Supabase Edge Function secrets)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Safety defaults. Keep disabled until the production provider/backend exists.
EXPO_PUBLIC_APP_MODE=demo
EXPO_PUBLIC_ENABLE_KYC_PROVIDER=false
EXPO_PUBLIC_ENABLE_PAYMENTS=true
EXPO_PUBLIC_ENABLE_SECURE_DELIVERY=false
EXPO_PUBLIC_ENABLE_PRECISE_LOCATION=false
