# Public client configuration. Never place service-role or private secrets here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend provider routing
# - supabase (default): existing Supabase-powered services
# - aws: uses AWS API Gateway endpoints for trips/parcels/requests
EXPO_PUBLIC_BACKEND_PROVIDER=supabase

# AWS API (required when EXPO_PUBLIC_BACKEND_PROVIDER=aws)
EXPO_PUBLIC_AWS_API_BASE_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com

# Optional dev-only token for temporary AWS API testing.
# Never set this in production builds because EXPO_PUBLIC_* values are client-visible.
# Remove once Cognito/OIDC user tokens are wired end-to-end.
EXPO_PUBLIC_AWS_API_BEARER_TOKEN=

# Cloudinary (public config only)
# NOTE: CLOUDINARY_API_SECRET is configured as a Supabase Edge Function secret, NOT here.
# supabase secrets set CLOUDINARY_API_SECRET=xxx CLOUDINARY_API_KEY=xxx
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=gac8q8it
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=carrygo_uploads

# Razorpay (public key only - secret stays in Supabase Edge Function secrets)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Safety defaults. Keep disabled until the production provider/backend exists.
EXPO_PUBLIC_APP_MODE=demo
EXPO_PUBLIC_ENABLE_KYC_PROVIDER=false
EXPO_PUBLIC_ENABLE_PAYMENTS=true
EXPO_PUBLIC_ENABLE_SECURE_DELIVERY=false
EXPO_PUBLIC_ENABLE_PRECISE_LOCATION=false
